  + service LOG                         | + parent
  + service Timer                       | + parent

+ option managed

+ start linphone_loading_backdrop | pkg: ssumpf/pkg/linphone_loading_backdrop/2025-10-20
  + route
    + service Gui | + parent | label: backdrop

+ start fonts_fs | pkg: fonts_fs
  + route
    + service ROM | label: config | + parent | label: config -> managed/fonts

+ start sntp_dummy_rtc | pkg: ssumpf/pkg/sntp_dummy_rtc/2025-10-27
  + route
    + service Nic | + child nic_router

+ start gpu | caps: 2000 | pkg: a64_lima_gpu-pinephone | priority: -1
  + affinity | xpos: 0 | width: 1
