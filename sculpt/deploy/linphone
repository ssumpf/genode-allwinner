+ start audio | pkg: a64_audio | priority: 0
  + affinity | xpos: 0 | ypos: 0 | width: 1 | height: 1
  + config | record_play: yes
  + route
    + service Play     | + child mixer
    + service Record   | + child mixer
    + service Platform | + parent | label: audio

+ start mixer | pkg: record_play_mixer | priority: 0
  + affinity | xpos: 0 | ypos: 0 | width: 1 | height: 1
  + config | jitter_ms: 23
  |
  | + mix linphone_left  | + play | label_suffix: linphonec -> left
  | + mix linphone_right | + play | label_suffix: linphonec -> right
  | + mix mic_left       | + play | label_suffix: audio -> mic_left
  | + mix mic_right      | + play | label_suffix: audio -> mic_right
  |
  | + policy | label_suffix: audio -> left  | record: linphone_left  | volume: 1.0
  | + policy | label_suffix: audio -> right | record: linphone_right | volume: 1.0
  |
  | + policy | label_suffix: linphonec -> left
  |          | period_ms: 46 | jitter_ms: 23 | record: mic_left  | volume: 1.0
  | + policy | label_suffix: linphonec -> right
  |          | period_ms: 46 | jitter_ms: 23 | record: mic_right | volume: 1.0
  |
  + route | + service Report | + parent

