config

+ parent-provides
  + service IRQ
  + service IO_MEM
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service Timer
  + service Event
  + service Report

+ default | caps: 100 | ram: 1M

+ service Platform    | + default-policy | + child platform
+ service Pin_control | + default-policy | + child a64_pio
+ service Pin_state   | + default-policy | + child a64_pio
+ service IRQ         | + default-policy | + child a64_pio

+ start platform | caps: 250 | ram: 3M | managing_system: yes
  + binary a64_platform
  + provides
    + service Platform
    + service Scp
  + route | + any-service | + parent
  + config
    + policy | label: a64_pio ->
      + device pio
    + policy | label: runtime -> fb -> | info: yes
      + device dphy
      + device dsi
      + device syscon
      + device de2_bus
      + device r_pwm
      + device tcon0
      + device tcon1
    + policy | label: runtime -> touch -> | info: yes
      + device i2c0
    + policy | label: uart_modem ->
      + device uart3
    + policy | label: a64_pio ->
      + device pio
    + policy | label: audio_control ->
      + device audio_codec
      + device audio_analog
      + device audio_codec_modem
      + device audio_codec_soc
    + policy | label: runtime -> usb -> | info: yes
      + device ehci1
      + device usb_phy
    + policy | label: runtime -> mmc -> | info: yes
      + device sd_card
      + device emmc
    + policy | label: runtime -> gpu | info: yes
      + device gpu
    + policy | label: runtime -> camera | info: yes
      + device csi
    + policy | label: runtime -> audio | info: yes
      + device audio_interface
      + device dma_controller
    + policy | label: runtime -> wifi | info: yes
      + device wifi_pwrseq
      + device mmc1
    + policy | label: power ->
      + device rintc
    + policy | label: button ->
      + device keyadc

+ start a64_pio
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + route
    + service ROM      | + parent
    + service CPU      | + parent
    + service PD       | + parent
    + service LOG      | + parent
    + service Platform | + child platform
  + config
    .
    . touchscreen
    .
    + select touchscreen-i2c-sck | bank: H | index:  0 | function: 2
    + select touchscreen-i2c-sda | bank: H | index:  1 | function: 2
    + out    touchscreen-int     | bank: H | index:  4
    + in     touchscreen-int     | bank: H | index:  4 | irq: falling
    + out    touchscreen-reset   | bank: H | index: 11
    + policy | label: runtime -> touch -> PH11 | pin: touchscreen-reset
    + policy | label: runtime -> touch -> PH4  | pin: touchscreen-int
    .
    . display
    .
    + select lcd-pwm   | bank: L | index: 10 | function: 2
    + out    backlight | bank: H | index: 10 | default: 0
    + out    lcd-reset | bank: D | index: 23 | default: 0
    + policy | label: runtime -> fb -> PH10 | pin: backlight
    + policy | label: runtime -> fb -> PD23 | pin: lcd-reset
    .
    . modem
    .
    + select modem-uart_tx | bank: D | index: 0 | function: 3 | . select uart3
    + select modem-uart_rx | bank: D | index: 1 | function: 3
    + out    4g-pwr-bat    | bank: L | index: 7
    + out    dtr           | bank: B | index: 2
    + out    enable        | bank: H | index: 8
    + out    host-ready    | bank: H | index: 7
    + out    pwrkey        | bank: B | index: 3
    + out    reset         | bank: C | index: 4
    + in     status        | bank: H | index: 9 | pull: up
    + in     ri            | bank: L | index: 6
    + policy | label: modem -> battery    | pin: 4g-pwr-bat
    + policy | label: modem -> dtr        | pin: dtr
    + policy | label: modem -> enable     | pin: enable
    + policy | label: modem -> host-ready | pin: host-ready
    + policy | label: modem -> pwrkey     | pin: pwrkey
    + policy | label: modem -> reset      | pin: reset
    + policy | label: modem -> ri         | pin: ri
    + policy | label: modem -> status     | pin: status
    .
    . AIF2 pins
    .
    + select aif2-sync   | bank: B | index: 4 | function: 2
    + select aif2-blk    | bank: B | index: 5 | function: 2
    + select aif2-dout   | bank: B | index: 6 | function: 2
    + select aif2-din    | bank: B | index: 7 | function: 2
    + out    speaker-amp | bank: C | index: 7 | default: on | . speaker
    .
    . camera
    .
    + select csi-pclk         | bank: E | index:  0 | function: 2
    + select csi-mclk         | bank: E | index:  1 | function: 2
    + select csi-hsync        | bank: E | index:  2 | function: 2
    + select csi-vsync        | bank: E | index:  3 | function: 2
    + select csi-d0           | bank: E | index:  4 | function: 2
    + select csi-d1           | bank: E | index:  5 | function: 2
    + select csi-d2           | bank: E | index:  6 | function: 2
    + select csi-d3           | bank: E | index:  7 | function: 2
    + select csi-d4           | bank: E | index:  8 | function: 2
    + select csi-d5           | bank: E | index:  9 | function: 2
    + select csi-d6           | bank: E | index: 10 | function: 2
    + select csi-d7           | bank: E | index: 11 | function: 2
    + out    csi-sck          | bank: E | index: 12
    + in     csi-sck          | bank: E | index: 12
    + out    csi-sda          | bank: E | index: 13
    + in     csi-sda          | bank: E | index: 13
    + out    gc2145-reset     | bank: E | index: 16
    + out    gc2145-powerdown | bank: E | index: 17
    + out    ov5460-powerdown | bank: C | index:  0
    + out    ov5460-reset     | bank: D | index:  3
    + in     ov5460-reset     | bank: D | index:  3
    + policy | label_suffix: -> camera -> PC0  | pin: ov5460-powerdown
    + policy | label_suffix: -> camera -> PD3  | pin: ov5460-reset
    + policy | label_suffix: -> camera -> PE12 | pin: csi-sck
    + policy | label_suffix: -> camera -> PE13 | pin: csi-sda
    + policy | label_suffix: -> camera -> PE16 | pin: gc2145-reset
    + policy | label_suffix: -> camera -> PE17 | pin: gc2145-powerdown
    .
    . wifi
    .
    + select sdc1_clk    | bank: G | index: 0 | function: 2
    + select sdc1_cmd    | bank: G | index: 1 | function: 2
    + select sdc1_d0     | bank: G | index: 2 | function: 2
    + select sdc1_d1     | bank: G | index: 3 | function: 2
    + select sdc1_d2     | bank: G | index: 4 | function: 2
    + select sdc1_d3     | bank: G | index: 5 | function: 2
    + out    wifi_pwrseq | bank: L | index: 2
    + policy | label: runtime -> wifi -> PL2 | pin: wifi_pwrseq

+ start terminal_crosslink | caps: 100
  + provides | + service Terminal
  + route
    + any-service | + parent

+ start modem | caps: 120
  + binary pinephone_modem
  + route
    + service ROM | label: config | + parent | label: modem.config
    + service Pin_control         | + child a64_pio
    + service Pin_state           | + child a64_pio
    + service Terminal            | + child terminal_crosslink
    + service ROM                 | + parent
    + service PD                  | + parent
    + service CPU                 | + parent
    + service LOG                 | + parent
    + service Timer               | + parent
    + service Report              | + parent

+ start uart_modem | ram: 2M
  + binary ns16550_uart
  + route
    + service Terminal | + child terminal_crosslink
    + service Platform | + child platform
    + any-service      | + parent

+ start audio_control
  + binary pinephone_audio_control
  + route
    + service ROM | label: config | + parent | label: audio.config
    + service Platform            | + child platform
    + any-service                 | + parent

+ start power
  + binary pinephone_power
  + config | period_ms: 10000 | system_rom: system
  + route
    + service Scp                 | + child platform
    + service Platform            | + child platform
    + service Report              | + parent | label: power
    + service ROM | label: system | + parent | label: system
    + any-service                 | + parent

+ start button
  + binary pinephone_button
  + config
  + route
    + service Platform | + child platform
    + any-service      | + parent
-
