build { core lib/ld init test/pin_interrupt }

create_boot_directory

install_config {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM
  + service IO_MEM
  + service IRQ

+ default | caps: 100 | ram: 1M

+ start test-pin_interrupt
  + route | + any-service | + parent
-
}

build_boot_image [build_artifacts]

run_genode_until forever
